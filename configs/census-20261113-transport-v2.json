{
  "version": "census-mcp-transport-v2",
  "default_page_limit": 10000,
  "retry_page_limit": 5000,
  "retry_small_page_tickers": [
    "AKAN",
    "BBAI"
  ],
  "reason": "Bound exports below the successfully validated 10,515-row CSV payload; reduce large-response Transport closed errors without changing population or replay",
